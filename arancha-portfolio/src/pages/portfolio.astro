---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Reveal from '../components/Reveal.astro';
import { projects, otherProjects, getAllTags } from '../data/projects';

const allTags = getAllTags();
const total = projects.length + otherProjects.length;
const base = import.meta.env.BASE_URL;
---

<Base
  title="Portfolio — Arancha Ramírez"
  description="Fifteen projects across design engineering, sustainable systems, and strategic analysis."
>
  <!-- ─── Header ─────────────────────────────────────────── -->
  <section class="port-header page-px max-w-page">
    <Reveal>
      <p class="serif-italic caption port-eyebrow">Portfolio</p>
      <h1 class="display-l">Selected work, 2021–2026</h1>
      <p class="body-l port-desc">
        Fifteen projects across design engineering, sustainable systems, and strategic analysis.
      </p>
    </Reveal>
  </section>

  <!-- ─── Tag filter ─────────────────────────────────────── -->
  <div class="filter-sticky" id="filter-bar">
    <div class="filter-inner page-px max-w-page">
      <div class="tag-scroll" role="toolbar" aria-label="Filter projects by tag">
        <button class="filter-tag active" data-tag="All">All</button>
        {allTags.map((tag) => (
          <button class="filter-tag" data-tag={tag}>{tag}</button>
        ))}
        <button class="filter-clear" id="filter-clear" aria-label="Clear all filters" hidden>
          Clear
        </button>
      </div>
      <p class="filter-meta micro" id="filter-meta" aria-live="polite">
        Showing {total} of {total} projects
      </p>
    </div>
  </div>

  <!-- ─── Unified grid ────────────────────────────────────── -->
  <section class="port-grid page-px max-w-page" aria-label="Project grid" id="project-grid">

    <!-- Case study projects (image cards) -->
    {projects.map((p, i) => (
      <div
        class="grid-item"
        data-slug={p.slug}
        data-tags={p.tags.join(',')}
      >
        <Reveal delay={i * 40}>
          <ProjectCard project={p} />
        </Reveal>
      </div>
    ))}

    <!-- Other projects (image cards, same treatment as case studies) -->
    {otherProjects.map((p, i) => (
      <div
        class="grid-item"
        data-slug={p.slug}
        data-tags={p.tags.join(',')}
      >
        <Reveal delay={(projects.length + i) * 40}>
          <ProjectCard project={p} href={`${base}/work/other/${p.slug}`} />
        </Reveal>
      </div>
    ))}

  </section>
</Base>

<style>
  .port-header {
    padding-top: calc(5rem + 4rem);
    padding-bottom: 2rem;
  }
  .port-eyebrow {
    margin: 0 0 0.5rem;
    color: var(--ink-muted);
  }
  .port-header h1 {
    margin: 0 0 1rem;
  }
  .port-desc {
    margin: 0;
    color: var(--ink-soft);
    max-width: 56ch;
  }

  /* ─── Filter bar ─────────────────────────────────────── */
  .filter-sticky {
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
  }
  .filter-inner {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .tag-scroll {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    width: max-content;
    max-width: 100%;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--rule);
  }

  .filter-tag {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    padding: 0.3em 0.85em;
    border-radius: 9999px;
    font-size: var(--micro);
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    border: 1px solid var(--rule);
    background: transparent;
    color: var(--ink-soft);
    transition: background 150ms ease, color 150ms ease, border-color 150ms ease;
  }
  .filter-tag:hover { background: var(--paper-soft); }
  .filter-tag.active {
    background: var(--accent-soft);
    color: var(--accent);
    border-color: transparent;
  }

  .filter-clear {
    margin-left: auto;
    flex-shrink: 0;
    font-size: var(--caption);
    font-family: var(--font-sans);
    color: var(--ink-muted);
    background: none;
    border: none;
    cursor: pointer;
    text-decoration: underline;
    transition: color 150ms ease;
  }
  .filter-clear:hover { color: var(--ink); }

  .filter-meta {
    color: var(--ink-muted);
    margin: 0;
  }

  /* ─── Grid — row-major flow, so project order reads left-to-right,
     top-to-bottom (most recent projects land in the top row). Rows are
     sized in cqw so they're exactly as tall as one column is wide —
     that gives true square base tiles, and "large" tiles (which span
     2 columns + 2 rows) become genuine 2x-size squares that interlock
     with the normal ones around them, rather than just stretching a
     whole row taller. ─────────────────────────────────────────────── */
  .port-grid {
    container-type: inline-size;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    /* cqw is relative to this element's border-box, which includes its
       own page-px padding — subtract that out so the row height lands
       on the actual (content-box) column width, not a padded estimate. */
    grid-auto-rows: calc((100cqw - 2 * var(--px) - 3 * 1.25rem) / 4);
    gap: 1.25rem;
    padding-top: 2rem;
    padding-bottom: 4rem;
  }
  .grid-item.hidden {
    display: none;
  }

  /* Never drop below 3 columns, even on narrow screens — large tiles
     still fit (2 of 3 columns), so no smaller-screen override is needed. */
  @media (max-width: 1100px) {
    .port-grid { grid-template-columns: repeat(3, 1fr); grid-auto-rows: calc((100cqw - 2 * var(--px) - 2 * 1.25rem) / 3); }
  }

  /* Stretch every card to fill its (now precisely square) grid cell,
     cropping images to fit rather than letting content drive height. */
  .grid-item {
    height: 100%;
    min-width: 0;
    min-height: 0;
  }
  .grid-item :global(.reveal),
  .grid-item :global(.project-card),
  .grid-item :global(.card-media) {
    height: 100%;
  }
  .grid-item :global(.card-media img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

<script>
  (() => {
    const grid = document.getElementById('project-grid')!;
    const items = Array.from(grid.querySelectorAll<HTMLElement>('.grid-item'));
    const filterBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-tag'));
    const clearBtn = document.getElementById('filter-clear') as HTMLButtonElement;
    const meta = document.getElementById('filter-meta')!;
    const total = items.length;

    let selected: Set<string> = new Set();

    const params = new URLSearchParams(window.location.search);
    params.getAll('tag').forEach((t) => selected.add(t));

    function updateURL() {
      const p = new URLSearchParams();
      selected.forEach((t) => p.append('tag', t));
      const qs = p.toString();
      history.replaceState(null, '', qs ? `?${qs}` : window.location.pathname);
    }

    function applyFilter() {
      let visible = 0;
      items.forEach((item) => {
        const tags = (item.dataset.tags ?? '').split(',');
        const show = selected.size === 0 || tags.some((t) => selected.has(t));
        item.classList.toggle('hidden', !show);
        if (show) visible++;
      });
      meta.textContent = `Showing ${visible} of ${total} projects`;
      if (clearBtn) clearBtn.hidden = selected.size === 0;
      filterBtns.forEach((btn) => {
        const tag = btn.dataset.tag ?? '';
        btn.classList.toggle('active', tag === 'All' ? selected.size === 0 : selected.has(tag));
      });
    }

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tag = btn.dataset.tag ?? '';
        if (tag === 'All') {
          selected.clear();
        } else {
          selected.has(tag) ? selected.delete(tag) : selected.add(tag);
        }
        updateURL();
        applyFilter();
      });
    });

    clearBtn?.addEventListener('click', () => {
      selected.clear();
      updateURL();
      applyFilter();
    });

    applyFilter();
  })();
</script>
