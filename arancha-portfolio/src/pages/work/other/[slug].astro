---
import Base from '../../../layouts/Base.astro';
import Reveal from '../../../components/Reveal.astro';
import { otherProjects } from '../../../data/projects';
import { assetUrl } from '../../../utils/url';

export function getStaticPaths() {
  return otherProjects.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const project = otherProjects.find((p) => p.slug === slug)!;
const base = import.meta.env.BASE_URL;
---

<Base
  title={`${project.title} — Arancha Ramírez`}
  description={project.one_line}
  accentColor={project.accent_color}
>

  <!-- Hero -->
  <section class="project-hero" style={`background-color: ${project.accent_color ?? 'var(--paper-soft)'};`}>
    <div class="hero-inner page-px max-w-page">
      <div class="hero-content">
        <div class="hero-text">
          <p class="hero-index micro">{project.index}</p>
          <h1 class="hero-title display-l">{project.title}</h1>
          <p class="hero-tagline serif-italic display-m">{project.one_line}</p>
        </div>
        {project.hero_image && (
          <div class="hero-media">
            <img
              src={assetUrl(project.hero_image)}
              alt={`${project.title} hero image`}
              class="hero-visual"
              loading="eager"
              decoding="async"
            />
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Meta strip -->
  <div class="meta-strip page-px">
    <div class="meta-inner max-w-page">
      <span class="meta-item micro">
        <span class="meta-label">Course</span>
        {project.course}
      </span>
      <span class="meta-divider" aria-hidden="true" />
      <span class="meta-item micro">
        <span class="meta-label">Year</span>
        {project.year}
      </span>
    </div>
  </div>

  <!-- Context / Problem / Solution -->
  <section class="ips-section page-px max-w-page section-gap">
    <div class="ips-grid">
      <Reveal>
        <div class="ips-col">
          <h2 class="serif-italic ips-label">Context</h2>
          <p class="body-l ips-text">{project.info}</p>
        </div>
      </Reveal>
      <Reveal delay={80}>
        <div class="ips-col">
          <h2 class="serif-italic ips-label">Problem</h2>
          <p class="body-l ips-text">{project.problem}</p>
        </div>
      </Reveal>
      <Reveal delay={160}>
        <div class="ips-col">
          <h2 class="serif-italic ips-label">Solution</h2>
          <p class="body-l ips-text">{project.solution}</p>
        </div>
      </Reveal>
    </div>
  </section>

  <!-- Footer: report CTA + back link -->
  <section class="project-footer page-px max-w-page section-gap">
    <hr class="rule" />
    <div class="project-footer-inner">
      {project.pdf_url && (
        <Reveal>
          <a
            href={assetUrl(project.pdf_url)}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-outline-sm"
          >
            Read the full report ↗
          </a>
        </Reveal>
      )}
      <Reveal delay={80}>
        <a href={`${base}/portfolio`} class="back-link caption">← Back to all work</a>
      </Reveal>
    </div>
  </section>

</Base>

<style>
  /* ─── Hero ───────────────────────────────────────────── */
  .project-hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 6rem;
    padding-bottom: 4rem;
  }
  .hero-inner {
    width: 100%;
    padding-top: 2rem;
    padding-bottom: 2rem;
  }
  .hero-content {
    display: grid;
    grid-template-columns: 45fr 55fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .hero-text {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .hero-index {
    color: currentColor;
    opacity: 0.5;
  }
  .hero-title {
    margin: 0;
    color: var(--ink);
  }
  .hero-tagline {
    margin: 0;
    color: var(--ink-soft);
  }
  .hero-visual {
    width: 100%;
    height: auto;
    border-radius: var(--radius-hero);
    display: block;
    object-fit: cover;
    animation: heroScale 1.2s var(--ease-out-expo) both;
  }
  @keyframes heroScale {
    from { transform: scale(1.05); opacity: 0; }
    to   { transform: scale(1);    opacity: 1; }
  }

  @media (max-width: 768px) {
    .hero-content {
      grid-template-columns: 1fr;
    }
    .hero-media {
      order: -1;
    }
    .project-hero {
      min-height: auto;
      padding-top: 5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-visual {
      animation: none;
    }
  }

  /* ─── Meta strip ─────────────────────────────────────── */
  .meta-strip {
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
    padding-top: 1rem;
    padding-bottom: 1rem;
  }
  .meta-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 0;
  }
  .meta-item {
    color: var(--ink-soft);
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0 1.25rem;
  }
  .meta-item:first-child {
    padding-left: 0;
  }
  .meta-label {
    font-size: 0.65rem;
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: var(--font-mono);
  }
  .meta-divider {
    width: 1px;
    height: 2rem;
    background: var(--rule);
    flex-shrink: 0;
  }
  @media (max-width: 700px) {
    .meta-divider { display: none; }
    .meta-inner { gap: 0.75rem; }
    .meta-item { padding: 0; }
  }

  /* ─── IPS (Context / Problem / Solution) ─────────────── */
  .ips-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
  }
  .ips-label {
    font-size: var(--caption);
    color: var(--ink-muted);
    margin: 0 0 0.75rem;
  }
  .ips-text {
    margin: 0;
    color: var(--ink-soft);
  }
  @media (max-width: 800px) {
    .ips-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  /* ─── Footer ─────────────────────────────────────────── */
  .project-footer {
    padding-bottom: 2rem;
  }
  .project-footer .rule {
    margin-bottom: 2.5rem;
  }
  .project-footer-inner {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .btn-outline-sm {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    padding: 0.65em 1.4em;
    border-radius: 9999px;
    border: 1.5px solid var(--ink);
    font-size: var(--caption);
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    transition: transform 200ms ease, background 200ms ease;
  }
  .btn-outline-sm:hover {
    background: var(--ink);
    color: var(--paper);
    transform: translateY(-2px);
  }
  .back-link {
    color: var(--ink-muted);
    text-decoration: none;
    transition: color 200ms ease;
  }
  .back-link:hover { color: var(--ink); }
</style>
