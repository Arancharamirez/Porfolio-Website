---
import { assetUrl } from '../utils/url';

export interface Props {
  project: {
    slug: string;
    title: string;
    index: string;
    one_line: string;
    hero_image?: string;
  };
  /** Defaults to `/work/<slug>` — pass an override for projects that live elsewhere (e.g. `/work/other/<slug>`). */
  href?: string;
  cardStyle?: string;
}

const { project, href, cardStyle } = Astro.props;
const base = import.meta.env.BASE_URL;
const linkHref = href ?? `${base}/work/${project.slug}`;
const heroImg = assetUrl(project.hero_image || `/images/projects/${project.slug}/hero.jpg`);
---

<a
  href={linkHref}
  class="project-card"
  style={cardStyle}
  aria-label={`${project.title} — ${project.one_line}`}
>
  <div class="card-media">
    <img
      src={heroImg}
      alt={project.title}
      loading="lazy"
      decoding="async"
      onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
    />
    <div class="card-placeholder" aria-hidden="true">
      <span class="card-placeholder-index micro">{project.index}</span>
    </div>
  </div>
  <div class="card-overlay" aria-hidden="true">
    <p class="card-title">{project.title}</p>
    <p class="card-desc">{project.one_line}</p>
  </div>
</a>
