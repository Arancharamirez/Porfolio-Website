---
import { assetUrl } from '../utils/url';

export interface Item {
  src: string;
  label: string;
  href?: string;
}

export interface Props {
  items: Item[];
  /** CSS selector of elements pieces should collide with instead of covering (e.g. the hero text). */
  avoid?: string;
}

const { items, avoid } = Astro.props;
---

<!-- Physics playground: PNG components fall from the top, stack on the floor,
     and can be dragged / thrown. A quick tap opens the item's link (if any)
     or makes it hop. -->
<div class="gravity-wrap" data-gravity data-avoid={avoid}>
  {items.map((item) => (
    <div
      class="gravity-item"
      data-href={item.href}
      role={item.href ? 'link' : undefined}
      tabindex={item.href ? 0 : undefined}
      aria-label={item.label}
    >
      <img src={assetUrl(item.src)} alt="" draggable="false" decoding="async" />
    </div>
  ))}
</div>

<style>
  .gravity-wrap {
    position: absolute;
    /* Clear of the fixed nav so pieces never land behind the header. */
    top: 6rem;
    right: 0;
    bottom: 0;
    left: 0;
    overflow: hidden;
    z-index: 1;
  }

  .gravity-item {
    position: absolute;
    top: 0;
    left: 0;
    /* Parked off-screen until the simulation places it. */
    transform: translate(-9999px, -9999px);
    cursor: grab;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    will-change: transform;
  }
  .gravity-item.is-dragging {
    cursor: grabbing;
    z-index: 2;
  }
  .gravity-item:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
  }

  .gravity-item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
    filter: drop-shadow(0 6px 14px rgba(26, 26, 26, 0.12));
  }

  @media (max-width: 767px) {
    /* On mobile the pieces fall behind the hero text and pile up under it. */
    .gravity-wrap {
      top: 4rem;
    }
  }
</style>

<script>
  import Matter from 'matter-js';

  const { Engine, Bodies, Body, Composite, Constraint, Query, Sleeping, Vertices } = Matter;

  const WALL = 200;          // wall thickness (px) — thick so fast throws can't tunnel
  const DROP_INTERVAL = 140; // ms between each piece being released
  const CLICK_MOVE = 6;      // px of pointer travel still counted as a click
  const CLICK_TIME = 300;    // ms
  const REST_SPEED = 4;      // below this a piece over the text counts as resting there
  const PUSH = 0.003;        // sideways shove (× mass) for pieces resting over the text
  const SETTLE_FALLBACK = 8000; // ms after the last drop to treat the pile as settled anyway
  // On phones pieces may pile up behind the text; once they settle, the avoided
  // elements get `gravity-settled` so the page can add a backdrop for legibility.
  const mobile = window.matchMedia('(max-width: 767px)');
  // Per-file size overrides (multiplier on the default size). Square PNGs default to 0.5.
  const SCALE: Record<string, number> = {
    'allink.png': 0.5,
    'ursa.png': 1.5,
    'nest_base.png': 1.33,
    'mario.png': 1.33,
    'actib.png': 1,
    'nest_dial.png': 0.67,
  };

  // ox/oy: offset from the body's centre of mass to the image centre (unrotated)
  type Piece = { el: HTMLElement; body: Matter.Body; w: number; h: number; ox: number; oy: number };

  function loaded(img: HTMLImageElement) {
    if (img.complete && img.naturalWidth) return Promise.resolve();
    return new Promise<void>((res) => {
      img.addEventListener('load', () => res(), { once: true });
      img.addEventListener('error', () => res(), { once: true });
    });
  }

  // Convex outline of the PNG's opaque pixels, in display px (0..w, 0..h), so pieces
  // collide on what's visible rather than on their transparent bounding box.
  function opaqueHull(img: HTMLImageElement, w: number, h: number) {
    const rect = [{ x: 0, y: 0 }, { x: w, y: 0 }, { x: w, y: h }, { x: 0, y: h }];
    try {
      const s = 64 / Math.max(img.naturalWidth, img.naturalHeight);
      const cw = Math.max(1, Math.round(img.naturalWidth * s));
      const ch = Math.max(1, Math.round(img.naturalHeight * s));
      const ctx = Object.assign(document.createElement('canvas'), { width: cw, height: ch }).getContext('2d')!;
      ctx.drawImage(img, 0, 0, cw, ch);
      const data = ctx.getImageData(0, 0, cw, ch).data;
      type Pt = { x: number; y: number };
      const pts: Pt[] = [];
      for (let y = 0; y < ch; y++) {
        let first = -1;
        let last = -1;
        for (let x = 0; x < cw; x++) {
          if (data[(y * cw + x) * 4 + 3] > 40) {
            if (first < 0) first = x;
            last = x;
          }
        }
        if (first >= 0) pts.push({ x: first, y }, { x: first, y: y + 1 }, { x: last + 1, y }, { x: last + 1, y: y + 1 });
      }
      if (pts.length < 3) return rect;
      // Andrew's monotone chain
      pts.sort((a, b) => a.x - b.x || a.y - b.y);
      const cross = (o: Pt, a: Pt, b: Pt) => (a.x - o.x) * (b.y - o.y) - (a.y - o.y) * (b.x - o.x);
      const half = (list: Pt[]) => {
        const out: Pt[] = [];
        for (const pt of list) {
          while (out.length >= 2 && cross(out[out.length - 2], out[out.length - 1], pt) <= 0) out.pop();
          out.push(pt);
        }
        out.pop();
        return out;
      };
      const hull = [...half(pts), ...half([...pts].reverse())];
      return hull.length < 3 ? rect : hull.map((pt) => ({ x: (pt.x * w) / cw, y: (pt.y * h) / ch }));
    } catch {
      return rect; // e.g. canvas unavailable
    }
  }

  async function init(wrap: HTMLElement) {
    const els = Array.from(wrap.querySelectorAll<HTMLElement>('.gravity-item'));
    if (!els.length) return;

    await Promise.all(els.map((el) => loaded(el.querySelector('img')!)));

    // Sleeping stops resting piles from slowly creeping; clearText wakes any piece asleep over the text
    const engine = Engine.create({ enableSleeping: true });
    engine.gravity.y = 1;

    let W = wrap.clientWidth;
    let H = wrap.clientHeight;

    // ── Walls: floor + sides, open at the top so pieces can enter ──
    const wallOpts = { isStatic: true, friction: 0.3 };
    const floor = Bodies.rectangle(0, 0, 1, 1, wallOpts);
    const left = Bodies.rectangle(0, 0, 1, 1, wallOpts);
    const right = Bodies.rectangle(0, 0, 1, 1, wallOpts);
    function layoutWalls() {
      const tall = H * 4;
      Body.setPosition(floor, { x: W / 2, y: H + WALL / 2 });
      Body.setVertices(floor, Bodies.rectangle(W / 2, H + WALL / 2, W + WALL * 2, WALL).vertices);
      Body.setPosition(left, { x: -WALL / 2, y: H - tall / 2 });
      Body.setVertices(left, Bodies.rectangle(-WALL / 2, H - tall / 2, WALL, tall).vertices);
      Body.setPosition(right, { x: W + WALL / 2, y: H - tall / 2 });
      Body.setVertices(right, Bodies.rectangle(W + WALL / 2, H - tall / 2, WALL, tall).vertices);
    }
    layoutWalls();
    Composite.add(engine.world, [floor, left, right]);

    // ── Text zones: pieces may fall *through* the hero text, but not rest on top of it.
    // Zones hug the actual text lines and buttons (no margin); any piece that slows down
    // while overlapping one gets shoved sideways out of the way.
    const avoidEls = wrap.dataset.avoid
      ? Array.from(document.querySelectorAll<HTMLElement>(wrap.dataset.avoid))
      : [];
    let zones: Matter.Body[] = [];
    let zoneMidX = W / 2;
    function layoutZones() {
      const wr = wrap.getBoundingClientRect();
      const rects: DOMRect[] = [];
      for (const el of avoidEls) {
        for (const child of Array.from(el.children)) {
          // A range's client rects are the individual text line boxes and inline elements
          const range = document.createRange();
          range.selectNodeContents(child);
          rects.push(...Array.from(range.getClientRects()).filter((r) => r.width && r.height));
        }
      }
      // Zones aren't added to the world; they're only used for overlap queries
      zones = rects
        .map((r) => ({ l: r.left - wr.left, t: r.top - wr.top, w: r.width, h: r.height }))
        .filter((r) => r.t + r.h > 0 && r.t < H && r.l + r.w > 0 && r.l < W)
        .map((r) => Bodies.rectangle(r.l + r.w / 2, r.t + r.h / 2, r.w, r.h, { isStatic: true }));
      if (zones.length) {
        const minX = Math.min(...zones.map((z) => z.bounds.min.x));
        const maxX = Math.max(...zones.map((z) => z.bounds.max.x));
        zoneMidX = (minX + maxX) / 2;
      }
    }

    function clearText() {
      if (!zones.length || mobile.matches) return;
      for (const p of pieces) {
        if (!released.has(p) || p.el.classList.contains('is-dragging') || p.body.speed > REST_SPEED) continue;
        if (Query.collides(p.body, zones).length) {
          Sleeping.set(p.body, false);
          const dir = p.body.position.x < zoneMidX ? -1 : 1;
          Body.applyForce(p.body, p.body.position, { x: dir * p.body.mass * PUSH, y: 0 });
        }
      }
    }

    // ── Pieces: sized by their longest side, aspect ratio preserved ──
    const maxSide = Math.max(90, Math.min(220, W * 0.14));
    const pieces: Piece[] = els.map((el) => {
      const img = el.querySelector('img')!;
      const ratio = img.naturalWidth && img.naturalHeight ? img.naturalWidth / img.naturalHeight : 1;
      // Square PNGs (the app/icon pieces) render at half size unless overridden in SCALE
      const file = decodeURIComponent(img.src.split('/').pop() || '');
      const isSquare = img.naturalWidth && img.naturalWidth === img.naturalHeight;
      const side = maxSide * (SCALE[file] ?? (isSquare ? 0.5 : 1));
      const w = ratio >= 1 ? side : side * ratio;
      const h = ratio >= 1 ? side / ratio : side;
      el.style.width = `${w}px`;
      el.style.height = `${h}px`;
      const hull = opaqueHull(img, w, h);
      const c = Vertices.centre(hull);
      const body = Bodies.fromVertices(0, 0, [hull], {
        friction: 0.2,
        frictionAir: 0.01,
        restitution: 0.25,
        density: 0.001,
      });
      return { el, body, w, h, ox: w / 2 - c.x, oy: h / 2 - c.y };
    });

    layoutZones();
    // Re-measure once the text's entrance animation has finished moving it
    setTimeout(layoutZones, 1200);

    const released = new Set<Piece>();

    function release(p: Piece) {
      // Start fully above the frame: half the diagonal clears the top edge at any rotation
      const radius = Math.hypot(p.w, p.h) / 2 + Math.hypot(p.ox, p.oy);
      Body.setPosition(p.body, {
        x: p.w / 2 + Math.random() * Math.max(1, W - p.w),
        y: -radius - 10 - Math.random() * 120,
      });
      Body.setAngle(p.body, (Math.random() - 0.5) * 0.8);
      Body.setAngularVelocity(p.body, (Math.random() - 0.5) * 0.05);
      Composite.add(engine.world, p.body);
      released.add(p);
    }

    function render() {
      for (const p of pieces) {
        if (!released.has(p)) continue; // stays parked off-screen until its turn
        const { position, angle } = p.body;
        const cos = Math.cos(angle);
        const sin = Math.sin(angle);
        // Image centre sits at the (rotated) offset from the centre of mass
        const cx = position.x + p.ox * cos - p.oy * sin;
        const cy = position.y + p.ox * sin + p.oy * cos;
        p.el.style.transform = `translate(${cx - p.w / 2}px, ${cy - p.h / 2}px) rotate(${angle}rad)`;
      }
    }

    let settled = false;
    function settle() {
      if (settled || !mobile.matches) return;
      settled = true;
      avoidEls.forEach((el) => el.classList.add('gravity-settled'));
    }
    function checkSettled() {
      if (settled || released.size < pieces.length) return;
      if (pieces.every((p) => p.body.isSleeping)) settle();
    }
    // A piece can jitter against a wall and never sleep, so settle anyway after a while
    setTimeout(settle, pieces.length * DROP_INTERVAL + SETTLE_FALLBACK);

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      // Skip the falling animation: drop everything and pre-settle the pile.
      pieces.forEach(release);
      for (let i = 0; i < 600; i++) {
        clearText();
        Engine.update(engine, 1000 / 60);
      }
      render();
    } else {
      pieces.forEach((p, i) => setTimeout(() => release(p), i * DROP_INTERVAL));
    }

    // ── Dragging: a spring between the pointer and the grabbed point ──
    let drag: {
      piece: Piece;
      constraint: Matter.Constraint;
      startX: number;
      startY: number;
      startT: number;
      moved: boolean;
    } | null = null;

    function local(e: PointerEvent) {
      const r = wrap.getBoundingClientRect();
      return { x: e.clientX - r.left, y: e.clientY - r.top };
    }

    for (const piece of pieces) {
      piece.el.addEventListener('pointerdown', (e) => {
        if (e.button !== 0 || drag) return;
        e.preventDefault();
        piece.el.setPointerCapture(e.pointerId);
        const pt = local(e);
        const { body } = piece;
        // Grab offset from the body centre; matter-js rotates it with the body
        const constraint = Constraint.create({
          pointA: pt,
          bodyB: body,
          pointB: { x: pt.x - body.position.x, y: pt.y - body.position.y },
          stiffness: 0.2,
          damping: 0.1,
          length: 0,
        });
        Sleeping.set(body, false);
        Composite.add(engine.world, constraint);
        drag = { piece, constraint, startX: e.clientX, startY: e.clientY, startT: performance.now(), moved: false };
        piece.el.classList.add('is-dragging');
      });

      piece.el.addEventListener('pointermove', (e) => {
        if (!drag || drag.piece !== piece) return;
        drag.constraint.pointA = local(e);
        Sleeping.set(piece.body, false);
        if (Math.hypot(e.clientX - drag.startX, e.clientY - drag.startY) > CLICK_MOVE) drag.moved = true;
      });

      const end = (e: PointerEvent) => {
        if (!drag || drag.piece !== piece) return;
        Composite.remove(engine.world, drag.constraint);
        piece.el.classList.remove('is-dragging');
        const isClick = !drag.moved && performance.now() - drag.startT < CLICK_TIME;
        drag = null;
        if (isClick && e.type === 'pointerup') activate(piece);
      };
      piece.el.addEventListener('pointerup', end);
      piece.el.addEventListener('pointercancel', end);

      piece.el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') activate(piece);
      });
    }

    function activate(piece: Piece) {
      const href = piece.el.dataset.href;
      if (href) {
        window.location.href = href;
        return;
      }
      // No link: give it a playful hop
      Sleeping.set(piece.body, false);
      Body.setVelocity(piece.body, { x: (Math.random() - 0.5) * 6, y: -12 });
      Body.setAngularVelocity(piece.body, (Math.random() - 0.5) * 0.3);
    }

    // ── Loop: fixed timestep, paused while the hero is off-screen ──
    let running = false;
    let raf = 0;
    function tick() {
      clearText();
      Engine.update(engine, 1000 / 60);
      render();
      checkSettled();
      raf = requestAnimationFrame(tick);
    }
    const io = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting && !running) {
        running = true;
        raf = requestAnimationFrame(tick);
      } else if (!entry.isIntersecting && running) {
        running = false;
        cancelAnimationFrame(raf);
      }
    });
    io.observe(wrap);

    // ── Resize: move walls, keep every piece inside the new bounds ──
    new ResizeObserver(() => {
      const nw = wrap.clientWidth;
      const nh = wrap.clientHeight;
      if (nw === W && nh === H) return;
      W = nw;
      H = nh;
      layoutWalls();
      layoutZones();
      for (const p of pieces) {
        const { x, y } = p.body.position;
        Body.setPosition(p.body, {
          x: Math.min(Math.max(x, p.w / 2), W - p.w / 2),
          y: Math.min(y, H - p.h / 2),
        });
        Sleeping.set(p.body, false);
      }
    }).observe(wrap);

    // Text can reflow (fonts loading, wrapping) without the play area resizing
    if (avoidEls.length) {
      const ro = new ResizeObserver(() => layoutZones());
      avoidEls.forEach((el) => ro.observe(el));
    }
  }

  document.querySelectorAll<HTMLElement>('[data-gravity]').forEach(init);
</script>
