---
import type { Project } from '../data/projects';
import { assetUrl } from '../utils/url';

export interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<!-- Pure background decoration — tiles are not interactive -->
<div class="constellation-wrap" aria-hidden="true">
  {projects.map((p, i) => (
    <div class="constellation-tile" data-index={i} data-slug={p.slug}>
      <img
        src={assetUrl(p.hero_image || `/images/projects/${p.slug}/hero.jpg`)}
        alt=""
        loading="eager"
        decoding="async"
        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
      />
      <div class="tile-fallback">
        <span>{String(i + 1).padStart(2, '0')}</span>
      </div>
    </div>
  ))}
</div>

<style>
  .constellation-wrap {
    position: absolute;
    /* Clear of the fixed nav (which has no background until scrolled) so
       tiles never drift behind the header and muddy its legibility. */
    top: 6rem;
    right: 0;
    bottom: 0;
    left: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 1;
  }

  .constellation-tile {
    position: absolute;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(26, 26, 26, 0.10);
  }

  .constellation-tile img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tile-fallback {
    display: none;
    width: 100%;
    height: 100%;
    background: var(--paper-soft);
    align-items: center;
    justify-content: center;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  @media (max-width: 767px) {
    .constellation-wrap { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .constellation-tile { animation: none !important; }
  }
</style>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reducedMotion) {
    const wrap = document.querySelector('.constellation-wrap');
    if (wrap) {

    const tiles = Array.from(wrap.querySelectorAll('.constellation-tile'));

    const aspectRatios = [1.3, 0.78, 1.0, 1.25, 0.82, 1.1, 1.35, 0.75, 1.0, 1.2, 1.15, 0.85];
    const widths       = [230, 270, 195, 310, 240, 205, 285, 250, 185, 260, 220, 215];

    // Fixed layout — [left %, top %, rotation deg]
    // Tiles placed around the perimeter, clear of the centre text block
    const positions = [
      [ 1,  6, -6],   // top-left corner
      [11,  2,  4],   // top, left of centre
      [70,  2, -5],   // top, right of centre
      [82,  6,  6],   // top-right corner
      [84, 42, -7],   // right edge, upper
      [81, 65,  4],   // right edge, lower
      [61, 78, -8],   // bottom, right of centre
      [10, 76,  5],   // bottom, left of centre
      [ 1, 52, -4],   // left edge, lower
      [ 2, 24,  7],   // left edge, upper
      [87, 25,  5],   // right edge, mid
      [ 4, 38, -5],   // left edge, mid
    ];

    // Deterministic drift — same every page load, no Math.random()
    const durations = [9000, 11500, 8200, 13000, 10800, 9600, 12200, 10000, 8800, 11000, 10200, 11700];
    const dxValues  = [ 18, -22,  14, -20,  24, -16,  20, -18,  16, -24, -19,  17];
    const dyValues  = [-14,  18, -12,  16, -20,  14, -16,  12, -18,  20,  15, -13];
    const drValues  = [  2,  -2, 1.5,  -2.5, 2, -1.5, 2.5,  -2, 1.5,  -2, -2, 2.2];
    const delays    = [  0, -3200, -6500, -1800, -8000, -4500, -2200, -7000, -5500, -3800, -2600, -5000];

    // One-off manual nudges for specific projects, keyed by slug so they
    // stick to the right image even if the underlying project order changes.
    const slugOverrides: Record<string, { left?: number; top?: number; width?: number; zIndex?: number }> = {
      foodji:      { top: 76 },              // moved further down
      'all-ink':   { left: 9, zIndex: -1 },  // shifted right, sent behind other tiles
      housescout:  { left: 14, width: 290, zIndex: 3 }, // shifted right, made larger, brought to front
      'two-step':  { left: 4, top: 84, zIndex: 2 }, // shifted further left and down, brought in front of hive-fu
    };

    tiles.forEach((tile, i) => {
      const slug = (tile as HTMLElement).dataset.slug ?? '';
      const override = slugOverrides[slug];

      let tw = override?.width ?? widths[i % widths.length];
      let [lp, tp, rot] = positions[i % positions.length];
      if (override?.left !== undefined) lp = override.left;
      if (override?.top !== undefined) tp = override.top;
      const th = Math.round(tw * aspectRatios[i % aspectRatios.length]);

      tile.style.width     = tw + 'px';
      tile.style.height    = th + 'px';
      tile.style.left      = lp + '%';
      // Tiles anchored in the lower half grow upward from `bottom` instead of
      // downward from `top` — otherwise their fixed pixel height can push
      // past the container's bottom edge and get clipped by overflow:hidden.
      if (tp >= 50) {
        tile.style.bottom = (100 - tp) + '%';
      } else {
        tile.style.top = tp + '%';
      }
      tile.style.transform = `rotate(${rot}deg)`;
      if (override?.zIndex !== undefined) tile.style.zIndex = String(override.zIndex);

      const dur   = durations[i % durations.length];
      const dx    = dxValues[i % dxValues.length];
      const dy    = dyValues[i % dyValues.length];
      const dr    = drValues[i % drValues.length];
      const delay = delays[i % delays.length];

      tile.animate(
        [
          { transform: `translate(0px, 0px) rotate(${rot}deg)` },
          { transform: `translate(${dx}px, ${dy}px) rotate(${rot + dr}deg)` },
        ],
        {
          duration: dur,
          iterations: Infinity,
          direction: 'alternate',
          easing: 'ease-in-out',
          delay,
          fill: 'both',
        }
      );
    });
    } // end if (wrap)
  }
</script>
