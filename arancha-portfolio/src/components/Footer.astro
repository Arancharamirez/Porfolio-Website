---
const base = import.meta.env.BASE_URL;
const year = 2026;
---
<footer class="site-footer page-px">
  <div class="footer-inner max-w-page">
    <hr class="rule" />

    <div class="footer-grid">
      <div class="footer-brand">
        <a href={base} class="footer-name serif-italic display-m">Arancha Ramírez</a>
        <p class="footer-tagline body">
          Design Engineering · Imperial College London.<br />
          Designing for human experience and environmental impact.
        </p>
      </div>

      <nav class="footer-col" aria-label="Footer navigation">
        <p class="footer-heading micro">Navigate</p>
        <ul class="footer-list" role="list">
          <li><a href={base} class="footer-link">Home</a></li>
          <li><a href={`${base}/portfolio`} class="footer-link">Portfolio</a></li>
          <li><a href={`${base}/about`} class="footer-link">About</a></li>
          <li><a href={`${base}/cv`} class="footer-link">CV</a></li>
        </ul>
      </nav>

      <div class="footer-col">
        <p class="footer-heading micro">Contact</p>
        <ul class="footer-list" role="list">
          <li>
            <a href="mailto:arancha.ramirez21@imperial.ac.uk" class="footer-link">
              arancha.ramirez21@imperial.ac.uk
            </a>
          </li>
          <li>
            <a
              href="https://linkedin.com/in/arancha-ramirez"
              target="_blank"
              rel="noopener noreferrer"
              class="footer-link"
            >
              LinkedIn ↗
            </a>
          </li>
        </ul>
      </div>

      <div class="footer-col">
        <p class="footer-heading micro">Based in</p>
        <p class="footer-link footer-static">London, UK</p>
        <p class="footer-link footer-static">Open to opportunities</p>
      </div>
    </div>

    <div class="footer-bottom">
      <span class="footer-copy">© Arancha Ramírez {year}</span>
      <a href="#main-content" class="footer-link footer-top">Back to top ↑</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--section-gap);
    padding-bottom: 2rem;
  }
  .footer-inner {
    padding-top: 1.5rem;
  }
  .rule {
    border: none;
    border-top: 1px solid var(--rule);
    margin: 0 0 3rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 2.5rem;
  }

  .footer-name {
    display: inline-block;
    color: var(--ink);
    text-decoration: none;
    margin: 0 0 0.75rem;
  }
  .footer-tagline {
    margin: 0;
    color: var(--ink-soft);
    max-width: 36ch;
  }

  .footer-heading {
    color: var(--ink-muted);
    margin: 0 0 1rem;
  }
  .footer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-link {
    font-size: var(--caption);
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 200ms ease;
  }
  .footer-link:hover {
    color: var(--ink);
  }
  .footer-static {
    margin: 0 0 0.6rem;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 3rem;
    flex-wrap: wrap;
  }
  .footer-copy {
    font-size: var(--caption);
    color: var(--ink-muted);
  }
  .footer-top {
    color: var(--ink-muted);
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      row-gap: 2.5rem;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
  }
</style>
