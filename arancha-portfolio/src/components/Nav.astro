---
const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;

function isActive(href: string) {
  if (href === base || href === `${base}/`) {
    return pathname === base || pathname === `${base}/`;
  }
  return pathname.startsWith(href);
}
---

<nav id="site-nav" aria-label="Main navigation">
  <div class="nav-inner">
    <a href={base} class="nav-logo" aria-label="Home — Arancha Ramírez">
      ARANCHA RAMÍREZ
    </a>
    <!-- Hamburger toggle (phones only); opens the links as a dropdown -->
    <button
      class="nav-toggle"
      id="nav-toggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="nav-links"
    >
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>
    <ul class="nav-links" id="nav-links" role="list">
      <li>
        <a href={`${base}/portfolio`} class:list={['nav-link', { active: isActive(`${base}/portfolio`) }]}>
          Portfolio
        </a>
      </li>
      <li>
        <a href={`${base}/cv`} class:list={['nav-link', { active: isActive(`${base}/cv`) }]}>
          CV
        </a>
      </li>
      <li>
        <a href={`${base}/about`} class:list={['nav-link', { active: isActive(`${base}/about`) }]}>
          About
        </a>
      </li>
    </ul>
  </div>
</nav>

<style>
  /* Header palette — fixed on every page, independent of page-level --ink overrides */
  #site-nav {
    --nav-ink: #660033;

    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    transition:
      background-color 300ms ease,
      backdrop-filter 300ms ease,
      transform 300ms var(--ease-out-expo);
  }
  #site-nav.scrolled {
    background-color: rgba(244, 241, 234, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--rule);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem var(--px);
    max-width: var(--max-w);
    margin: 0 auto;
  }

  .nav-logo {
    font-family: var(--font-sans);
    font-size: var(--micro);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--nav-ink);
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    font-family: var(--font-sans);
    font-size: var(--body);
    font-weight: 500;
    color: var(--nav-ink);
    text-decoration: none;
    position: relative;
    padding-bottom: 2px;
    transition: color 200ms ease;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--nav-ink);
    transition: width 300ms var(--ease-out-expo);
  }
  .nav-link.active {
    color: var(--nav-ink);
  }
  .nav-link.active::after,
  .nav-link:hover::after {
    width: 100%;
  }

  .nav-toggle {
    display: none;
  }

  /* ─── Phones: links collapse into a dropdown behind the hamburger ─── */
  @media (max-width: 767px) {
    .nav-inner {
      position: relative;
    }

    .nav-toggle {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 2.5rem;
      height: 2.5rem;
      margin-right: -0.5rem; /* optically align the bars with the page edge */
      padding: 0.5rem;
      background: none;
      border: none;
      cursor: pointer;
    }
    .nav-toggle-bar {
      display: block;
      width: 100%;
      height: 2px;
      border-radius: 2px;
      background: var(--nav-ink);
      transition: transform 250ms var(--ease-out-expo), opacity 200ms ease;
    }
    /* Bars morph into an × while open */
    .nav-toggle[aria-expanded='true'] .nav-toggle-bar:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .nav-toggle[aria-expanded='true'] .nav-toggle-bar:nth-child(2) {
      opacity: 0;
    }
    .nav-toggle[aria-expanded='true'] .nav-toggle-bar:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }

    .nav-links {
      position: absolute;
      top: calc(100% - 0.25rem);
      right: var(--px);
      flex-direction: column;
      gap: 0;
      min-width: 11rem;
      padding: 0.5rem 0;
      background: rgba(244, 241, 234, 0.97);
      border: 1px solid var(--rule);
      border-radius: 12px;
      box-shadow: 0 10px 30px rgba(26, 26, 26, 0.12);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-6px);
      transition: opacity 200ms ease, transform 250ms var(--ease-out-expo), visibility 0s linear 250ms;
    }
    .nav-links.open {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      transition: opacity 200ms ease, transform 250ms var(--ease-out-expo), visibility 0s;
    }
    .nav-links li {
      display: block;
    }
    .nav-link {
      display: block;
      padding: 0.7rem 1.25rem;
    }
    /* Underline doesn't suit a stacked menu; mark the current page with a tint instead */
    .nav-link::after {
      display: none;
    }
    .nav-link.active {
      background: #EFE5EA;
    }
  }
</style>

<script>
  (() => {
    const toggle = document.getElementById('nav-toggle');
    const menu = document.getElementById('nav-links');
    if (!toggle || !menu) return;

    function setOpen(open: boolean) {
      menu!.classList.toggle('open', open);
      toggle!.setAttribute('aria-expanded', String(open));
      toggle!.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    }

    toggle.addEventListener('click', () => setOpen(!menu.classList.contains('open')));
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('click', (e) => {
      const t = e.target as Node;
      if (!menu.contains(t) && !toggle.contains(t)) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.classList.contains('open')) {
        setOpen(false);
        toggle.focus();
      }
    });
    // Leaving the phone layout while open shouldn't leave stale state behind
    window.matchMedia('(max-width: 767px)').addEventListener('change', () => setOpen(false));
  })();
</script>
